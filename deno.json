{
  "name": "@denostack/openauth",
  "version": "0.7.0",
  "exports": {
    ".": "./core/mod.ts",
    "./apple": "./apple/mod.ts",
    "./atlassian": "./atlassian/mod.ts",
    "./discord": "./discord/mod.ts",
    "./facebook": "./facebook/mod.ts",
    "./github": "./github/mod.ts",
    "./gitlab": "./gitlab/mod.ts",
    "./google": "./google/mod.ts",
    "./kakao": "./kakao/mod.ts",
    "./line": "./line/mod.ts",
    "./linkedin": "./linkedin/mod.ts",
    "./naver": "./naver/mod.ts",
    "./slack": "./slack/mod.ts"
  },
  "tasks": {
    "bench": "deno run --allow-run=deno --allow-write=.benchmark scripts/benchmark.ts",
    "test": "deno task test:unit && deno task test:lint && deno task test:format && deno task test:types",
    "test:format": "deno fmt --check",
    "test:lint": "deno lint",
    "test:unit": "deno test -A",
    "test:types": "find . -name '*.ts' -not -path './.npm/*' | xargs deno check",
    "build:npm": "deno run --allow-env --allow-read --allow-write --allow-run scripts/build_npm.ts"
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.42.3",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fmt": "jsr:@std/fmt@^1.0.9",
    "@std/testing": "jsr:@std/testing@^1.0.17"
  },
  "lint": {
    "exclude": [".npm"]
  },
  "fmt": {
    "exclude": [".npm"],
    "lineWidth": 120
  },
  "publish": {
    "exclude": [".npm", ".github", ".vscode", "scripts", "examples", "**/*.test.ts"]
  }
}
